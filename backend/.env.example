# Django Secrets & Config
# ------------------------
SECRET_KEY=your-secret-key-here
DEBUG=true

# ------------------------
# Redis & Queue
# ------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------
# Kindness Features
# ------------------------
KINDNESS_MIN_NOTES=3
KINDNESS_RECENT_NOTES_LIMIT=7

# ------------------------
# OpenAI Key (optional)
# ------------------------
OPENAI_API_KEY=

# ------------------------
# SMTP Email Config (Brevo)
# ------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-master-password
SMTP_USE_TLS=true

DEFAULT_FROM_EMAIL=ThryveSpace <thryvespace.contact@gmail.com>
CONTACT_INBOX=thryvespace.contact@gmail.com

# ------------------------
# DRF Throttling (Optional)
# ------------------------
DRF_THROTTLE_USER=1000/day
DRF_THROTTLE_ANON=100/day
DRF_THROTTLE_CONTACT=5/hour


